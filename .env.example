# Copy this file to .env and fill in your keys. .env is git-ignored.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Meta Model API (Muse Spark) - the default provider
MODEL_API_KEY=your_meta_model_api_key_here
# MODEL_API_URL=https://api.meta.ai/v1/chat/completions
# MODEL_NAME=muse-spark-1.3

# Baseten (OpenAI-compatible, Muse Spark open weights). Used as a fallback when Meta fails,
# or as the default when AI_PROVIDER=baseten. Only the key is required; the URL and model
# below are the built-in defaults.
# BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# AI_PROVIDER=meta

# Reasoning effort for Muse Spark (minimal | low | medium | high | xhigh | max). Low keeps the Studio agent at
# about 6-10 s per turn and the AI repair at about 25 s.
# PLAYLAB_AGENT_EFFORT=low
# PLAYLAB_FIX_EFFORT=low

# Supabase: relay fallback for the phone link when WebRTC cannot connect (mobile data, strict Wi-Fi),
# and the saved games of PlayLab Studio (run db/schema.sql once in the SQL editor).
# Public values (the publishable key is meant for browsers); served to the pages by api/config.js.
# Supabase dashboard -> Project Settings -> API: Project URL and the "publishable" key (sb_publishable_...).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...

# Server-only key for the PlayLab database functions (waitlist, rate limits, admin sync, test accounts). Never in a page.
# Generate one:  node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# then store its SHA-256 in the database:  select private.set_server_key_hash('<sha256 hex>');
# PLAYLAB_SERVER_KEY=

# Comma-separated emails that become admins (the first admin).
# ADMIN_EMAILS=you@example.com
