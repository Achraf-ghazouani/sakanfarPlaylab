{
  "name": "sakanfar-playlab",
  "version": "0.3.0",
  "private": true,
  "description": "Draw a platformer level on paper, photograph it, and play it in the browser (Meta Muse Spark hackathon).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node serve.mjs",
    "serve": "node serve.mjs",
    "test": "node tests/i18n.test.mjs && node tests/ai.test.mjs && node tests/paper.test.mjs && node tests/image.test.mjs && node tests/code.test.mjs",
    "test:auth": "node tests/auth.test.mjs http://localhost:3000",
    "test:db": "node tests/db.test.mjs",
    "test:studio": "node tests/studio.test.mjs http://localhost:3000",
    "test:admin": "node tests/admin.test.mjs http://localhost:3000",
    "dev:https": "node serve.mjs --https",
    "test:publish": "node tests/publish.test.mjs http://localhost:3000",
    "test:assets": "node tests/assets.test.mjs http://localhost:3000",
    "samples": "node tests/make-samples.mjs",
    "test:sdk": "node tests/sdk.test.mjs http://localhost:3000",
    "test:anygame": "node tests/anygame.test.mjs http://localhost:3000",
    "run:html": "node tests/run-html.mjs",
    "test:pad": "node tests/pad.test.mjs http://localhost:3000",
    "test:publish-code": "node tests/publish-code.test.mjs http://localhost:3000",
    "test:voice": "node tests/voice.test.mjs"
  }
}
