# Copy this file to .env and fill in your keys. .env is git-ignored.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Meta Model API (Muse Spark) - the default provider
MODEL_API_KEY=your_meta_model_api_key_here
# MODEL_API_URL=https://api.meta.ai/v1/chat/completions
# MODEL_NAME=muse-spark-1.3

# Baseten (OpenAI-compatible, Muse Spark open weights). Used as a fallback when Meta fails,
# or as the default when AI_PROVIDER=baseten. Only the key is required; the URL and model
# below are the built-in defaults.
# BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# AI_PROVIDER=meta
