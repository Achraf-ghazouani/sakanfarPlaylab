{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/scan.js": { "maxDuration": 60 },
    "api/fix.js": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/lib/(.*)", "destination": "/_not_served" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/levels/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
