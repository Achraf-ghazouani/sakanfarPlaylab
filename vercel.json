{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/agent.js": {
      "maxDuration": 300
    },
    "api/art.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/play/:id",
      "destination": "/api/play?id=:id"
    },
    {
      "source": "/api/build-code",
      "destination": "/api/agent?task=code"
    }
  ],
  "redirects": [
    {
      "source": "/lib/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/levels/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
